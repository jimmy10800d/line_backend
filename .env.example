# LINE 自動化流程引擎 - 環境變數範例
# LINE Workflow Automation Engine - Environment Variables Example
#
# 使用方式：複製此檔案為 .env 並填入實際值
# cp .env.example .env

# ===== 應用程式設定 =====
# 應用程式名稱
APP_NAME=LINE Workflow Automation
# 執行環境：development / staging / production
APP_ENV=development
# 除錯模式（開發環境設為 true）
DEBUG=true
# 伺服器主機
HOST=0.0.0.0
# 伺服器埠號
PORT=8000

# ===== 資料庫設定 =====
# SQLite 資料庫路徑（相對於專案根目錄）
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# ===== LINE Bot 設定 =====
# LINE Channel Access Token（從 LINE Developers Console 取得）
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here
# LINE Channel Secret（從 LINE Developers Console 取得）
LINE_CHANNEL_SECRET=your_channel_secret_here

# ===== OpenAI 設定 =====
# OpenAI API Key（從 OpenAI Platform 取得）
OPENAI_API_KEY=your_openai_api_key_here
# OpenAI 模型（預設使用 gpt-4o-mini，成本效益高）
OPENAI_MODEL=gpt-4o-mini

# ===== Google OAuth 設定（Google Calendar 整合）=====
# Google OAuth Client ID
GOOGLE_CLIENT_ID=your_google_client_id_here
# Google OAuth Client Secret
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# Google OAuth Redirect URI
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google_calendar/callback

# ===== Notion 設定 =====
# Notion Integration Token（從 Notion Developers 取得）
NOTION_INTEGRATION_TOKEN=your_notion_integration_token_here

# ===== GitHub 設定 =====
# GitHub OAuth App Client ID
GITHUB_CLIENT_ID=your_github_client_id_here
# GitHub OAuth App Client Secret
GITHUB_CLIENT_SECRET=your_github_client_secret_here
# GitHub OAuth Redirect URI
GITHUB_REDIRECT_URI=http://localhost:8000/api/integrations/github/callback

# ===== 天氣 API 設定 =====
# OpenWeatherMap API Key（從 OpenWeatherMap 取得）
WEATHER_API_KEY=your_weather_api_key_here

# ===== 加密設定 =====
# Token 加密金鑰（用於加密 OAuth Token，請使用強密碼）
# 可使用以下指令產生：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_encryption_key_here

# ===== 日誌設定 =====
# 日誌等級：DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO
# 日誌格式：json / console
LOG_FORMAT=console

# ===== 時區設定 =====
# 固定使用台灣時區
TIMEZONE=Asia/Taipei
